<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup/transfer rules.

    allowBackup="false" already stops cloud backup on older versions; from
    Android 12 the cloud and device-to-device transfer paths are configured
    here instead. Both exclude everything: the app holds a session token and a
    student's progress, and neither should travel to another device outside a
    deliberate sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
